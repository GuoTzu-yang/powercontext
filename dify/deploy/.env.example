# ============================================================
# Dify 1.18 部署：本作品新增/修改的环境变量（全部为占位值）
# 用法：把这些项追加/覆盖到 Dify 源码的 docker/.env 里
# ============================================================

# ---------- 1. 向量库：pgvector（替代 weaviate） ----------
VECTOR_STORE=pgvector

# ---------- 2. 允许 HTTP 节点访问私网 PowerContext ----------
# 填「承载 PowerContext 的主机地址」；同 compose 网络填其网段；
# 若 PowerContext 公网可达，可留空。
SSRF_PROXY_ALLOW_PRIVATE_IPS=<private-host-or-cidr>

# ---------- 3. 模型供应商（MiniMax，OpenAI 兼容） ----------
# 注意：供应商凭据不在 .env 里生效，需在控制台/API 配置模型时填入。
# 这里只把值登记成占位，避免误提交真实密钥。
MINIMAX_API_KEY=<your-key>
MINIMAX_BASE_URL=https://api.minimax.chat/v1
MINIMAX_MODEL=MiniMax-M3.1-Flash

# ---------- 4. PowerContext（应用运行时地址，写在 DSL 环境变量里，此处仅备注） ----------
# 实际生效位置：应用 → 工作流 → 环境变量 → POWERCONTEXT_BASE_URL
POWERCONTEXT_BASE_URL=http://powercontext:8099

# ---------- 5. 保持默认（此处显式列出，便于评审核对） ----------
# 官方插件已签名，无需关闭校验
FORCE_VERIFYING_SIGNATURE=true
PLUGIN_STORAGE_TYPE=local
MARKETPLACE_ENABLED=true

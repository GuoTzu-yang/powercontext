# 复制为 .env 后填写；.env 不入库，密钥不落盘
#
# 变量名兼容：凭据可用下列任一变量名注入（优先级从左到右）
#   MM_MINIMAX_API_KEY（推荐） > MINIMAX_API_KEY > MINIMAX_API_TOKEN
#   > MINIMAX_KEY > MINIMAX_GROUP_KEY > OPENAI_API_KEY
#   评测方若统一注入其他命名，无需改动代码即可生效。
# MiniMax（OpenAI 兼容接口）
MM_MINIMAX_API_KEY=sk-api-<your-key-here>
MM_MINIMAX_BASE_URL=https://api.minimax.chat/v1/chat/completions
MM_MINIMAX_MODEL=MiniMax-M3.1-Flash
MM_MINIMAX_MAX_TOKENS=8192
MM_MINIMAX_TIMEOUT=300

# OceanBase / seekdb（MySQL 协议）
MM_OB_HOST=127.0.0.1
MM_OB_PORT=2881
MM_OB_USER=root@sys
MM_OB_PASSWORD=
MM_OB_DATABASE=mm_sdd

# 流程
MM_TASK_ID=TASK-001
MM_PC_SCOPE=mm-sdd-task-001
